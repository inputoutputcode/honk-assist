# ElevenLabs (TTS)
ELEVENLABS_API_KEY=your_elevenlabs_key
ELEVENLABS_VOICE_ID=9IzcwKmvwJcw58h3KnlH

# OpenClaw Agent Bridge (set OPENCLAW_GATEWAY_TOKEN to enable)
OPENCLAW_GATEWAY_URL=https://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_gateway_token
OPENCLAW_AGENT_ID=honkassist
HONK_WAKE_WORD=Honk
HONK_WAKE_WORD_ENABLED=true

# Server
BASE_URL=https://bot.staycurio.io
LOGURU_LEVEL=DEBUG
PIPECAT_LOG_LEVEL=DEBUG
